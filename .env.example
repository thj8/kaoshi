# 凭据模板：cp .env.example .env 后改成随机值
# MySQL root 密码（首次建库生效；改密码需 ALTER USER 'root'@'localhost' 和 'root'@'%' 两个账号）
MYSQL_ROOT_PASSWORD=change-me-openssl-rand-hex-16
REDIS_PASSWORD=change-me-openssl-rand-hex-16
# JWT 签名密钥（openssl rand -hex 32），空则服务拒绝启动
JWT_SECRET=change-me-openssl-rand-hex-32
ADMIN_USER=admin
# 管理端密码，空或 admin123 拒绝启动
ADMIN_PASS=change-me-openssl-rand-base64-12
